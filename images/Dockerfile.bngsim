# bngsim, ready to run: the released package from PyPI, with BioNetGen 2.9.3
# so BNGL models load, and a C compiler for bngsim's compiled right-hand sides.
# For using bngsim, not for testing a tree (the other images do that).
#
#   docker run --rm -v "$PWD":/work montanamendy/bngsim python model_script.py
#
# amd64 installs PyPI's manylinux wheels. arm64 has no bngsim or antimony
# wheel on PyPI: bngsim is built here from its sdist (with KLU), and antimony
# from its source (scripts/build-antimony.sh), in a stage of their own, so the
# image carries no build tools. Both architectures load Antimony models.
#
#   python bngsim_docker.py build --kind bngsim                # bngsim-run:latest
#   python bngsim_docker.py build --kind bngsim --arch arm64   # bngsim-run-arm64:latest
ARG PYTHON_VERSION=3.12.16

# ── wheels: bngsim and its extras, and BioNetGen ─────────────────────────────
FROM python:${PYTHON_VERSION}-slim-bookworm AS wheels
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG BNGSIM_VERSION=0.17.2
ARG ANTIMONY_VERSION=3.3.0
ARG BNG_VERSION=2.9.3
# sha256 of BioNetGen-2.9.3-linux.tar.gz, the RuleWorld/bionetgen release asset.
ARG BNG_SHA256=b85743d422aa3fd112aceb3725dd1b1f2ff1ad829d20d71682680426582bcb5d
ARG TARGETARCH

# arm64 builds bngsim and antimony from source: a compiler, CMake, Ninja, KLU,
# and the expat and zlib antimony links.
RUN if [ "$TARGETARCH" = arm64 ]; then \
        apt-get update \
        && apt-get install -y --no-install-recommends build-essential cmake ninja-build libsuitesparse-dev git \
           libexpat1-dev zlib1g-dev \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# hadolint ignore=DL3022
RUN --mount=type=bind,from=scripts,source=build-antimony.sh,target=/usr/local/bin/build-antimony.sh \
    mkdir -p /wheels \
    && if [ "$TARGETARCH" = arm64 ]; then bash /usr/local/bin/build-antimony.sh "$ANTIMONY_VERSION" /wheels; fi

# The same antimony on both architectures: PyPI's on amd64, the one built above
# on arm64 (found in /wheels).
RUN printf '%s\n' "bngsim[pandas,xarray,hdf5,antimony]==${BNGSIM_VERSION}" "antimony==${ANTIMONY_VERSION}" > /requirement.txt \
    && CMAKE_BUILD_PARALLEL_LEVEL=2 pip wheel --no-cache-dir --find-links /wheels --wheel-dir /wheels -r /requirement.txt

# BioNetGen, checked against its sha256. BNG2.pl is Perl and runs on either
# architecture; it is what turns a .bngl file into a network for bngsim.
RUN python -c "import hashlib, urllib.request; \
url = 'https://github.com/RuleWorld/bionetgen/releases/download/BioNetGen-${BNG_VERSION}/BioNetGen-${BNG_VERSION}-linux.tar.gz'; \
data = urllib.request.urlopen(url, timeout=300).read(); \
assert hashlib.sha256(data).hexdigest() == '${BNG_SHA256}', 'BioNetGen sha256 does not match'; \
open('/bng.tgz', 'wb').write(data)"
RUN mkdir -p /opt && tar -xzf /bng.tgz -C /opt && rm /bng.tgz

# ── the image ────────────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim-bookworm AS bngsim
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG BNGSIM_VERSION=0.17.2
ARG BNG_VERSION=2.9.3
ARG TARGETARCH

# perl: BNG2.pl. gcc and libc6-dev: bngsim compiles a model's right-hand side
# for speed when a C compiler is there. libexpat1: python-libsbml's XML parser
# (the slim image leaves it out, and every SBML load fails without it).
# libklu1 and liblapack3: the KLU and LAPACK the arm64 build links (the amd64
# wheel carries its own).
# $extra is split on purpose: none, or two package names (SC2086).
# hadolint ignore=SC2086
RUN extra=""; if [ "$TARGETARCH" = arm64 ]; then extra="libklu1 liblapack3"; fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends perl gcc libc6-dev libexpat1 $extra \
    && rm -rf /var/lib/apt/lists/*

COPY --from=wheels /opt/BioNetGen-${BNG_VERSION} /opt/BioNetGen-${BNG_VERSION}
ENV BNGPATH=/opt/BioNetGen-${BNG_VERSION}

RUN --mount=type=bind,from=wheels,source=/wheels,target=/wheels \
    --mount=type=bind,from=wheels,source=/requirement.txt,target=/requirement.txt \
    pip install --no-cache-dir --no-index --find-links /wheels -r /requirement.txt \
    && python -c "import bngsim; assert bngsim.__version__ == '${BNGSIM_VERSION}', bngsim.__version__" \
    && perl "$BNGPATH/BNG2.pl" -v | grep -q "BioNetGen version ${BNG_VERSION}"

# Where the image comes from, and what it is for: Docker Hub and other tools
# read these (the OCI image annotations) to link the image to its source.
LABEL org.opencontainers.image.source="https://github.com/Montana/bngsim-docker" \
      org.opencontainers.image.description="bngsim, the BioNetGen simulation engine from Los Alamos National Laboratory, ready to run: BNGL, SBML and Antimony models, ODE and stochastic simulation"

# Any user can run the image (docker run --user "$(id -u):$(id -g)", so what a
# script writes to a mounted folder is the caller's, not root's). bngsim keeps
# its compiled models and generated networks under $HOME/.cache: a home every
# user can write to (sticky, like /tmp), or a compiled model fails with
# "Permission denied: '/.cache'" for any user but root. /work too, for a run
# with no folder mounted there.
# .cache itself is made here and writable too: a build of the amd64 image under
# Rosetta (Docker Desktop on Apple Silicon) writes .cache/rosetta as root.
ENV HOME=/home/bngsim
RUN mkdir -p /home/bngsim/.cache /work && chmod 1777 /home/bngsim /home/bngsim/.cache /work

# Examples to try first: python /examples/run.py (and, in the jupyter image,
# /examples/tour.ipynb)
COPY examples /examples

# A copy of this file, which the CLI compares with the repository's to say when
# the image is older than its Dockerfile. Last, so no other layer depends on
# it.
COPY Dockerfile.bngsim /etc/bngsim-docker/Dockerfile.bngsim
# hadolint ignore=DL3022
COPY --from=scripts build-antimony.sh /etc/bngsim-docker/build-antimony.sh
WORKDIR /work
CMD ["python"]

# ── jupyter: the same, with JupyterLab and matplotlib, for notebooks ─────────
#   docker run --rm -p 8888:8888 -v "$PWD":/work montanamendy/bngsim:jupyter
# then open the http://127.0.0.1:8888/lab?token=... address it prints. The
# token stays on: anyone who can reach the port could otherwise run code.
FROM bngsim AS jupyter
ARG JUPYTERLAB_VERSION=4.6.6
ARG MATPLOTLIB_VERSION=3.11.2
RUN pip install --no-cache-dir "jupyterlab==${JUPYTERLAB_VERSION}" "matplotlib==${MATPLOTLIB_VERSION}"
EXPOSE 8888
# --allow-root: the image runs as root unless given --user; --ip: reachable
# through the published port, not only from inside the container.
# The file browser starts in /work (the mounted folder) with / as its root, so
# /examples, and its tour.ipynb, are one level up; the examples are writable by
# any user, so a notebook opened there can be saved.
RUN chmod -R a+w /examples
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", \
     "--ServerApp.root_dir=/", "--FileContentsManager.preferred_dir=/work"]
